  <rdf:Description rdf:about="https://example.org/nde-research#NDE004">
    <rdf:type rdf:resource="https://example.org/nde-research#NDEStudy"/>
    <rdfs:label>Xu et al.</rdfs:label>
    <nde:studyYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2023</nde:studyYear>
    <nde:studyDesign>small observational physiological study</nde:studyDesign>
    <nde:evidenceClass>study_summary</nde:evidenceClass>
    <nde:limitation>no direct patient NDE reports linked to measured gamma activity</nde:limitation>
    <nde:sampleSize rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</nde:sampleSize>
    <nde:hasSource rdf:resource="https://example.org/nde-research#NDE004_source"/>
    <nde:investigates rdf:resource="https://example.org/nde-research#NDE004_event"/>
    <nde:observes rdf:resource="https://example.org/nde-research#NDE004_finding"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/nde-research#NDE002">
    <rdf:type rdf:resource="https://example.org/nde-research#NDEStudy"/>
    <rdfs:label>Parnia et al. AWARE I</rdfs:label>
    <nde:studyYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2014</nde:studyYear>
    <nde:studyDesign>prospective observational study</nde:studyDesign>
    <nde:evidenceClass>study_summary</nde:evidenceClass>
    <nde:limitation>different categories of reported awareness; timing and independent verification remain difficult</nde:limitation>
    <nde:hasSource rdf:resource="https://example.org/nde-research#NDE002_source"/>
    <nde:investigates rdf:resource="https://example.org/nde-research#NDE002_event"/>
    <nde:observes rdf:resource="https://example.org/nde-research#NDE002_finding"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/nde-research#NDE003">
