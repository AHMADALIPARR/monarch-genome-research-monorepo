    <nde:studyYear rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2023</nde:studyYear>
    <nde:studyDesign>multicenter prospective observational study</nde:studyDesign>
    <nde:evidenceClass>study_summary</nde:evidenceClass>
    <nde:limitation>EEG observations and recollections do not establish consciousness outside brain</nde:limitation>
    <nde:sampleSize rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">567</nde:sampleSize>
    <nde:hasSource rdf:resource="https://example.org/nde-research#NDE003_source"/>
