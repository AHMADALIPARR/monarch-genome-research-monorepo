PREFIX gs:   <https://example.org/genome-stack#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>

SELECT ?proposal ?status ?review WHERE { ?proposal a gs:ProposedEdit . OPTIONAL { ?proposal gs:reviewStatus ?status . } OPTIONAL { ?proposal gs:requiresReview ?review . } } ORDER BY ?proposal
