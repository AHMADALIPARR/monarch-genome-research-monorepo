PREFIX gs:   <https://example.org/genome-stack#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>

SELECT ?class ?parent WHERE { ?class a owl:Class . OPTIONAL { ?class rdfs:subClassOf ?parent . } FILTER(STRSTARTS(STR(?class),"https://example.org/genome-stack#")) } ORDER BY ?class
