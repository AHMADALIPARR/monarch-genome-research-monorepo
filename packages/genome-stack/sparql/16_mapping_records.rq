PREFIX gs:   <https://example.org/genome-stack#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>

SELECT ?mapping ?gene ?location ?assembly ?chromosome ?coordinateConvention WHERE { ?mapping a gs:MappingRecord ; gs:mapsGene ?gene ; gs:hasLocation ?location . OPTIONAL { ?location gs:relativeToAssembly ?assembly . } OPTIONAL { ?location gs:chromosome ?chromosome . } OPTIONAL { ?location gs:coordinateConvention ?coordinateConvention . } } ORDER BY ?gene ?location
