PREFIX gs:   <https://example.org/genome-stack#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>

SELECT DISTINCT ?entity ?type WHERE { gs:image01 gs:depicts ?entity . ?entity a ?type . VALUES ?moleculeClass { gs:DNA gs:RNA } ?type rdfs:subClassOf* ?moleculeClass . FILTER NOT EXISTS { ?entity gs:sequence ?sequence . } } ORDER BY ?entity
