PREFIX gs:   <https://example.org/genome-stack#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>

SELECT ?event ?nuclease ?guide ?target ?break WHERE { ?event a gs:CleavageEvent ; gs:usesNuclease ?nuclease ; gs:usesGuide ?guide ; gs:hasTarget ?target ; gs:producesBreak ?break . }
