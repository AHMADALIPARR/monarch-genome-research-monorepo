PREFIX gs:   <https://example.org/genome-stack#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>

SELECT ?layer ?function (COUNT(DISTINCT ?upstream) AS ?position) WHERE { ?layer a gs:ArchitectureLayer ; gs:layerFunction ?function . OPTIONAL { ?upstream gs:feedsLayer+ ?layer . } } GROUP BY ?layer ?function ORDER BY ?position
