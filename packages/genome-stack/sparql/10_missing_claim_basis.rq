PREFIX gs:   <https://example.org/genome-stack#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>

SELECT ?subject ?predicate ?object WHERE { VALUES ?predicate { gs:usesGuide gs:usesNuclease gs:hasTarget gs:producesBreak gs:hasPAM gs:usesTemplate gs:repairs } ?subject ?predicate ?object . FILTER NOT EXISTS { ?axiom a owl:Axiom ; owl:annotatedSource ?subject ; owl:annotatedProperty ?predicate ; owl:annotatedTarget ?object ; gs:claimBasis ?basis . } } ORDER BY ?subject ?predicate
