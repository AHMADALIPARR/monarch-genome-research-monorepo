PREFIX gs:   <https://example.org/genome-stack#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>

SELECT ?entity (COUNT(DISTINCT ?observation) AS ?labelOccurrenceCount) WHERE { ?observation a gs:LabelObservation ; gs:denotes ?entity . } GROUP BY ?entity HAVING(COUNT(DISTINCT ?observation) > 1) ORDER BY DESC(?labelOccurrenceCount)
